# Configuración de Base de Datos
DATABASE_URL=sqlite:datos.db

# Configuración del Servidor
PORT=3000
HOST=0.0.0.0

# Configuración de Sesiones (cambiar en producción)
SESSION_SECRET=cambiar-por-secreto-seguro-en-produccion

# Configuración de Horarios de Registro (formato HH:MM)
REGISTRO_HORA_1=14:00
REGISTRO_HORA_2=02:00

# Ventana de tolerancia en minutos
VENTANA_TOLERANCIA_MINUTOS=119

# Timeout de sesión en horas
SESSION_TIMEOUT_HORAS=8

# Configuración de ngrok
# Consigue tu token en https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=tu_token_aqui

# Configuración de Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Sistema de Temperaturas
NOTIFICACIONES_ACTIVAS=0

# Nombre de la Empresa
EMPRESA_NOMBRE=
